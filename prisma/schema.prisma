// =====================================================================
// COBRANÇA PIX AVULSA — cobranças PIX rápidas geradas no painel financeiro,
// não vinculadas a uma Venda/Parcela. Pode ser para cliente cadastrado ou ad-hoc.
// =====================================================================

model CobrancaAvulsa {
  id          String    @id @default(cuid())
  loteadoraId String
  loteadora   Loteadora @relation(fields: [loteadoraId], references: [id], onDelete: Cascade)

  // Cliente vinculado (opcional)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  // Dados ad-hoc (usados quando cliente não está cadastrado)
  nomeAdHoc     String?
  cpfCnpjAdHoc  String?
  emailAdHoc    String?
  telefoneAdHoc String?

  // Lote vinculado (opcional — usado quando a cobrança é da entrada de um lote)
  loteId String?
  lote   Lote?   @relation(fields: [loteId], references: [id], onDelete: SetNull)

  valor      Decimal  @db.Decimal(12, 2)
  descricao  String?
  vencimento DateTime

  // Asaas
  asaasCustomerId String?
  asaasPaymentId  String? @unique
  asaasInvoiceUrl String?
  asaasPixCode    String? @db.Text
  asaasPixQrCode  String? @db.Text

  status CobrancaAvulsaStatus @default(PENDENTE)
  pagoEm DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteadoraId, status])
  @@index([clienteId])
  @@index([loteId])
  @@map("cobrancas_avulsas")
}

enum CobrancaAvulsaStatus {
  PENDENTE
  PAGO
  CANCELADO
  ESTORNADO
}

// =====================================================================
// FORMULÁRIOS CUSTOMIZADOS — coleta de dados/documentos de clientes
// =====================================================================

model Formulario {
  id          String     @id @default(cuid())
  loteadoraId String?
  loteadora   Loteadora? @relation(fields: [loteadoraId], references: [id], onDelete: Cascade)

  // Identificação
  slug      String  @unique // usado em /f/<slug>
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  // Vinculo opcional com loteamento (afeta dropdown de lotes)
  loteamentoId String?
  loteamento   Loteamento? @relation(fields: [loteamentoId], references: [id], onDelete: SetNull)

  // Definição dos campos (JSON com lista de FormCampo)
  campos Json

  // Aparência / textos
  corPrimaria     String?
  logo            String?
  mensagemSucesso String? // mostrado após envio
  redirectUrl     String? // se setado, redireciona após envio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  respostas FormularioResposta[]

  @@index([loteadoraId, ativo])
  @@map("formularios")
}

model FormularioResposta {
  id           String     @id @default(cuid())
  formularioId String
  formulario   Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)

  // Dados extraídos (indexados para busca rápida)
  nome       String?
  cpfCnpj    String?
  email      String?
  telefone   String?
  loteCodigo String?

  // Todas as respostas (dadosCampoId → valor)
  dados Json

  status FormularioRespostaStatus @default(NOVA)

  // Tracking
  ipAddress String?
  userAgent String?

  // Quem visualizou pela primeira vez
  vistaEm  DateTime?
  vistaPor String?

  arquivos FormularioArquivo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formularioId, status, createdAt])
  @@index([cpfCnpj])
  @@map("formulario_respostas")
}

enum FormularioRespostaStatus {
  NOVA
  EM_ANALISE
  PROCESSADA
  ARQUIVADA
}

model FormularioArquivo {
  id         String             @id @default(cuid())
  respostaId String
  resposta   FormularioResposta @relation(fields: [respostaId], references: [id], onDelete: Cascade)

  // qual campo do formulário (ex: "rg", "comprovante_residencia")
  campoId String

  nomeOriginal String
  caminho      String // path em disco, ex: /uploads/formularios/<respostaId>/<file>
  mimeType     String?
  tamanho      Int? // bytes

  createdAt DateTime @default(now())

  @@index([respostaId])
  @@map("formulario_arquivos")
}

// ---------------------------------------------------------------------------
// Interessados na PLATAFORMA (donos de loteadora querendo assinar o sistema).
// Nao confundir com Lead, que e quem quer comprar um LOTE.
// ---------------------------------------------------------------------------

model Interessado {
  id       String  @id @default(cuid())
  nome     String
  email    String
  telefone String
  /// Nome do plano escolhido no site (texto livre — os planos vivem na landing)
  plano    String
  mensagem String?

  status       InteressadoStatus @default(NOVO)
  respondidoEm DateTime?
  /// Anotacoes internas do time comercial
  observacoes  String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("interessados")
}

enum InteressadoStatus {
  NOVO
  NEGOCIANDO
  CLIENTE
  PERDIDO
}

// ---------------------------------------------------------------------------
// Lock de cron. A tabela ja existia no banco e era manipulada apenas por SQL
// cru (src/app/api/cron/regua-cobranca). Declarar aqui evita que um
// `prisma db push` a derrube — o que pararia a regua de cobranca.
// ---------------------------------------------------------------------------

model CronLock {
  name        String    @id
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  @@map("cron_locks")
}

// =====================================================================
// BACKOFFICE DA PLATAFORMA — assinatura das empresas-cliente
// ---------------------------------------------------------------------
// Aqui quem paga e a LOTEADORA, e quem recebe e a meuloteamento. Nao
// confundir com Parcela/CobrancaAvulsa, que sao o cliente final pagando a
// loteadora — outra ponta, outra chave Asaas (ver asaas-context.ts).
//
// Tudo aqui e aditivo: nenhuma tabela existente muda. Loteadora ganha
// apenas a relacao inversa, que nao cria coluna.
// =====================================================================

model Plano {
  id   String @id @default(cuid())
  nome String @unique
  slug String @unique

  valorMensal Decimal @db.Decimal(12, 2)
  descricao   String?

  /// Limites do plano. NULL = ilimitado. Por ora sao informativos: quem
  /// decide bloquear e o backoffice, nao o contador de recursos.
  maxLoteamentos Int?
  maxLotes       Int?
  maxUsuarios    Int?

  ativo Boolean @default(true)
  ordem Int     @default(0)

  assinaturas Assinatura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planos")
}

model Assinatura {
  id String @id @default(cuid())

  /// Uma assinatura por loteadora. Sem assinatura cadastrada, a loteadora
  /// opera normalmente — e assim que a Germanos fica de fora ate voce
  /// decidir cadastra-la.
  loteadoraId String    @unique
  loteadora   Loteadora @relation(fields: [loteadoraId], references: [id], onDelete: Cascade)

  planoId String?
  plano   Plano?  @relation(fields: [planoId], references: [id], onDelete: SetNull)

  status AssinaturaStatus @default(TRIAL)

  /// Valor cobrado de fato. Nasce copiado do plano, mas e editavel: um
  /// desconto negociado com um cliente nao pode mudar o preco dos outros.
  valorMensal Decimal @db.Decimal(12, 2)

  /// Dia do vencimento. Limitado a 28 para existir em fevereiro.
  diaVencimento Int @default(10)

  /// Atraso tolerado antes do bloqueio. Da tempo de o boleto compensar e de
  /// alguem ligar para o cliente antes de derrubar o sistema dele.
  diasTolerancia Int @default(10)

  trialAte DateTime?

  /// Desligar manual — tem prioridade sobre qualquer calculo de atraso.
  bloqueioManual Boolean   @default(false)
  motivoBloqueio String?
  bloqueadaEm    DateTime?

  /// Cliente no Asaas da PLATAFORMA (nao o da loteadora).
  asaasCustomerId String?

  observacoes String?

  faturas AssinaturaFatura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("assinaturas")
}

model AssinaturaFatura {
  id String @id @default(cuid())

  assinaturaId String
  assinatura   Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  /// Competencia no formato AAAA-MM.
  competencia String

  valor      Decimal  @db.Decimal(12, 2)
  vencimento DateTime

  status FaturaStatus @default(PENDENTE)

  pagoEm    DateTime?
  valorPago Decimal?  @db.Decimal(12, 2)

  asaasPaymentId String? @unique
  linkPagamento  String?
  pixCopiaECola  String?

  /// AUTOMATICA = gerada pelo cron. MANUAL = lancada por alguem no
  /// backoffice. Numa conferencia, saber o que o sistema lancou sozinho e o
  /// que alguem lancou a mao evita discussao.
  origem FaturaOrigem @default(AUTOMATICA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O que torna a geracao mensal idempotente: rodar duas vezes na mesma
  /// competencia esbarra aqui, no banco, e nao numa checagem em memoria.
  @@unique([assinaturaId, competencia])
  @@index([status, vencimento])
  @@map("assinatura_faturas")
}

enum AssinaturaStatus {
  TRIAL
  ATIVA
  INADIMPLENTE
  BLOQUEADA
  CANCELADA
}

enum FaturaStatus {
  PENDENTE
  PAGA
  CANCELADA
}

enum FaturaOrigem {
  AUTOMATICA
  MANUAL
}

// =====================================================================
// WhatsApp — caixa de entrada
// =====================================================================

/// Instância de WhatsApp pareada por um usuário do admin.
///
/// Uma por usuário: quem pareia o celular é a pessoa que atende, e a conversa
/// nasce dentro do número dela. O `token` é gerado por nós ANTES de pedir o
/// `create` ao gateway — é ele que autentica as chamadas daquela instância e
/// que compõe a URL do webhook, então precisa existir antes de qualquer
/// mensagem poder chegar.
model WhatsappInstancia {
  id String @id @default(cuid())

  userId String    @unique
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Denormalizado do usuário para filtrar sem join. Nulo = super admin.
  loteadoraId String?
  loteadora   Loteadora? @relation(fields: [loteadoraId], references: [id], onDelete: Cascade)

  /// Nome da instância no gateway (único lá).
  nome             String  @unique
  /// 32 hex. Autentica as chamadas e compõe a URL do webhook.
  token            String  @unique
  /// Id que o gateway devolve no create.
  instanciaGateway String?

  /// Número pareado, só depois que o QR é lido.
  telefone   String?
  perfilNome String?

  status      WhatsappStatus @default(DESCONECTADA)
  conectadaEm DateTime?
  ultimoErro  String?

  conversas WhatsappConversa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteadoraId, status])
  @@map("whatsapp_instancias")
}

/// Modelo de mensagem pronta, com tokens {{nome}}.
///
/// Quem atende repete as mesmas cinco frases o dia inteiro — dados do lote,
/// formas de pagamento, horário de visita. Digitar de novo a cada conversa é
/// onde o atendimento perde tempo e ganha erro de digitação.
model WhatsappModelo {
  id String @id @default(cuid())

  loteadoraId String?
  loteadora   Loteadora? @relation(fields: [loteadoraId], references: [id], onDelete: Cascade)

  titulo String
  texto  String
  /// Atalho digitado no campo para inserir o modelo (ex: "/precos").
  atalho String?

  /// Quantas vezes foi usado — os mais usados sobem na lista.
  usos Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteadoraId])
  @@map("whatsapp_modelos")
}

enum WhatsappStatus {
  DESCONECTADA
  PAREANDO
  CONECTADA
  ERRO
}

/// Uma conversa (contato ou grupo) dentro de uma instância.
model WhatsappConversa {
  id          String            @id @default(cuid())
  instanciaId String
  instancia   WhatsappInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  /// Identificador do WhatsApp: 5511999999999@s.whatsapp.net ou ...@g.us
  remoteJid String
  telefone  String?
  nome      String?
  ehGrupo   Boolean @default(false)

  naoLidas              Int       @default(0)
  ultimaMensagemEm      DateTime?
  ultimaMensagemMinha   Boolean?
  /// Prévia curta para a lista, evitando carregar a última mensagem inteira.
  ultimaMensagemPreview String?

  fotoUrl          String?
  fotoAtualizadaEm DateTime?

  arquivada Boolean @default(false)

  /// Situação do atendimento. Mensagem do cliente reabre conversa encerrada.
  situacao String @default("novo")

  /// De onde veio o nome atual: manual | contatos | push | numero.
  /// Nome vindo da agenda não pode ser rebaixado pelo apelido da próxima
  /// mensagem, que muitas vezes é só um emoji ou o nome da loja.
  nomeOrigem String  @default("numero")
  /// Quem renomeou na mão tinha um motivo — nenhuma sincronização desfaz.
  nomeManual Boolean @default(false)

  /// Etiquetas livres da conversa, para filtrar a fila.
  etiquetas Json?

  /// Fixada no topo da fila. Espelha o "fixar" do WhatsApp.
  fixada     Boolean @default(false)
  /// Silenciada: continua chegando, para de contar como não lida.
  silenciada Boolean @default(false)

  /// Quando pedimos o histórico deste chat ao WhatsApp. A marca fica aqui, e
  /// não numa consulta por JID: o mesmo contato chega ora como
  /// `…@s.whatsapp.net`, ora como `…@lid`, e a busca pela forma errada
  /// concluiria que a conversa não existe, repedindo o histórico para sempre.
  historicoPedido DateTime?

  /// Liga a conversa ao funil: quem está falando é (ou vira) um lead.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  mensagens WhatsappMensagem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O mesmo contato em duas instâncias são duas conversas — são caixas de
  /// entrada diferentes, de pessoas diferentes.
  @@unique([instanciaId, remoteJid])
  @@index([instanciaId, ultimaMensagemEm])
  @@index([leadId])
  @@map("whatsapp_conversas")
}

model WhatsappMensagem {
  id         String           @id @default(cuid())
  conversaId String
  conversa   WhatsappConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  /// Id da mensagem no WhatsApp. Com a conversa, é a chave de idempotência:
  /// o webhook reentrega o mesmo evento e não pode duplicar a bolha na tela.
  messageId String

  daMim Boolean
  tipo  WhatsappTipoMensagem @default(TEXTO)
  texto String?

  /// Caminho da mídia NO COFRE (/uploads/whatsapp/...), nunca em public/:
  /// cliente manda foto de documento por WhatsApp o tempo todo.
  /// Ver lib/storage-seguro.ts.
  midiaCaminho String?
  midiaMime    String?
  midiaTamanho Int?
  /// Nome original do documento, para exibir e para o download.
  nomeArquivo  String?
  /// Duração de áudio/vídeo em segundos.
  duracao      Int?

  transcricao       String?
  transcricaoStatus String?

  /// Só em grupo: quem falou. O telefone e o nome exibido NO MOMENTO — o nome
  /// muda depois, e o histórico precisa continuar legível com o que valia
  /// quando a mensagem chegou.
  participante     String?
  participanteNome String?

  /// Mensagem citada (o "responder" do WhatsApp). Guarda o id e um resumo: a
  /// citada pode ser apagada depois, e a citação precisa continuar legível —
  /// ela é o contexto do que foi respondido.
  respondeA      String?
  respondeATexto String?
  respondeADeMim Boolean?

  /// Reação (emoji) colocada nesta mensagem.
  reacao String?

  /// Nota interna: só aparece aqui, NUNCA vai para o WhatsApp. É o recado que
  /// a equipe deixa sobre a conversa sem o cliente ver.
  notaInterna Boolean @default(false)

  status    WhatsappStatusMensagem @default(PENDENTE)
  editada   Boolean                @default(false)
  /// Momento informado pelo WhatsApp, não o da gravação: mensagem antiga
  /// chega em sincronia de histórico e precisa cair na posição certa.
  enviadaEm DateTime

  createdAt DateTime @default(now())

  @@unique([conversaId, messageId])
  @@index([conversaId, enviadaEm])
  @@map("whatsapp_mensagens")
}

enum WhatsappTipoMensagem {
  TEXTO
  IMAGEM
  VIDEO
  AUDIO
  DOCUMENTO
  STICKER
  LOCALIZACAO
  CONTATO
  SISTEMA
}

enum WhatsappStatusMensagem {
  PENDENTE
  ENVIADA
  ENTREGUE
  LIDA
  ERRO
}
