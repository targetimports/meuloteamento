# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meuloteamento?schema=public"

# Asaas
# Sandbox:    https://api-sandbox.asaas.com/v3
# Produção:   https://api.asaas.com/v3
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY="$aact_SUA_CHAVE_AQUI"
ASAAS_WEBHOOK_TOKEN=""

# Autenticação (em produção: >=32 chars, OBRIGATÓRIO)
JWT_SECRET="troque-isto-por-uma-string-aleatoria-de-no-minimo-32-chars"
JWT_SECRET_CLIENTE="outra-string-aleatoria-diferente-com-no-minimo-32-chars"
SESSION_COOKIE_NAME="meuloteamento_session"
CLIENTE_COOKIE_NAME="meuloteamento_cliente"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Multi-tenant
BASE_DOMAIN="meuloteamento.com"
CUSTOM_DOMAINS=""

# Cron — OBRIGATÓRIO em produção (>=24 chars, header X-Cron-Token)
CRON_TOKEN="troque-este-token-em-producao-pra-string-aleatoria"

# WhatsApp (régua de cobrança, mensagens em massa, recuperação senha)
# Provider: "zapi" | "meta_cloud"
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
WHATSAPP_INSTANCE=""

# Email transacional
# Provider: "resend"
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@meuloteamento.com"

# Assinatura eletrônica de contratos
# Provedor global (override por loteadora em Loteadora.signProvider/signApiToken)
SIGN_PROVIDER="clicksign"          # ou "zapsign"
SIGN_SANDBOX="true"                # "true" durante testes; "false" em produção
CLICKSIGN_API_TOKEN=""             # gere no painel Clicksign > Conta > Token de API
ZAPSIGN_API_TOKEN=""               # alternativa: ZapSign

# Webhooks IN — leads externos (1 segredo por provedor)
LEAD_WEBHOOK_SECRET_FACEBOOK=""
LEAD_WEBHOOK_SECRET_TYPEFORM=""

# Sentry (opcional — para captura de erros)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
